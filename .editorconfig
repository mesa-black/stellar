# One style for every editor that opens this repository: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is formatted by gofmt, which indents with tabs.
[{*.go,go.mod,Makefile}]
indent_style = tab
indent_size = 4

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Reference vectors are compared byte for byte: leave them as they are.
[testdata/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
